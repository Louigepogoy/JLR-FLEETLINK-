PORT=5000
NODE_ENV=development

# Neon PostgreSQL (recommended)
# Copy from Neon Dashboard → Connection string → pooled
# Example:
# DATABASE_URL=postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_SSL=true

# Local PostgreSQL (alternative)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/jlr_fleetlink
# DATABASE_SSL=false

JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

FRONTEND_URL=http://localhost:3000
# Other addresses serving the same frontend (custom domain, *.vercel.app), comma-separated. Allowed by CORS.
EXTRA_FRONTEND_URLS=
API_BASE_URL=http://localhost:5000

# PayMongo payment gateway (real GCash/card/Maya checkout for bookings and subscriptions).
# Get your Secret Key from https://dashboard.paymongo.com -> Developers -> API Keys,
# and the Webhook Signing Secret from Developers -> Webhooks.
PAYMONGO_SECRET_KEY=your-paymongo-secret-key
PAYMONGO_WEBHOOK_SECRET=your-paymongo-webhook-signing-secret

# Gmail SMTP for login OTP emails
# Use a Gmail account with 2-Step Verification enabled, then generate an
# "App Password" (Google Account -> Security -> App passwords) — do NOT use your normal Gmail password.
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_APP_PASSWORD=your-16-character-app-password

# Google Gemini API key for AI-assisted license/vehicle verification in the admin dashboard.
# Get a free key (no credit card needed) at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Google Sign-In (OAuth client from Google Cloud Console -> APIs & Services -> Credentials).
# GOOGLE_CLIENT_ID is also used by the frontend (NEXT_PUBLIC_GOOGLE_CLIENT_ID) to render the button.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Optional: detects Gmail addresses that do not exist at sign-up when the host blocks outbound port 25
# (e.g. Railway). Get a key for the "Email Reputation API" at abstractapi.com (free tier: 100 checks/month).
ABSTRACT_EMAIL_API_KEY=

# Cloudinary file storage for uploaded photos/videos (license, selfie, vehicle photos, chat media). Free plan, no card.
# Cloudinary dashboard -> API Keys -> "API Environment variable". When set, uploads go to Cloudinary so localhost and
# the deployed site show the same files; when empty they are saved to backend/uploads (lost on redeploy on most hosts).
# Existing files: run `npm run uploads:migrate -- --apply` once after setting it.
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Minutes between background sweeps (auto-cancel unpaid bookings, inspection reminders, auto payouts). Default 15.
# Keep it high on Neon free plan: a 1-minute timer keeps the database awake 24/7 and exhausts the compute hours.
SWEEP_INTERVAL_MINUTES=15
